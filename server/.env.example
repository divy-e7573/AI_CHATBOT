# Server
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/ai_chatbot

# Secret used to sign JWT auth tokens
JWT_SECRET=your_jwt_secret_here

# API key for the chat/completion AI provider (used later by the chat service)
AI_API_KEY=your_ai_api_key_here

# Cohere API key used to generate embeddings for RAG
COHERE_API_KEY=your_cohere_api_key_here

# Optional chat providers. These keys stay on this server only.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Optional provider model overrides
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.0-flash

# Chroma vector DB server URL (run: `chroma run --path ./chroma-data`)
CHROMA_URL=http://localhost:8000
