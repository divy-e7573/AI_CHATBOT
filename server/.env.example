# Server
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/ai_chatbot

# Secret used to sign JWT auth tokens
JWT_SECRET=your_jwt_secret_here

# API key for the chat/completion AI provider (used later by the chat service)
AI_API_KEY=your_ai_api_key_here

# Cohere API key used to generate embeddings for RAG
COHERE_API_KEY=your_cohere_api_key_here

# Chroma vector DB server URL (run: `chroma run --path ./chroma-data`)
CHROMA_URL=http://localhost:8000
