# Server port
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/ai_chatbot

# Secret used to sign JWT auth tokens
JWT_SECRET=your_jwt_secret_here

# Cohere API key used for chat generation and optional vector embeddings
COHERE_API_KEY=your_cohere_api_key_here

# Optional Chroma vector database. Uploads and document search still work
# through the MongoDB fallback when Chroma is not running.
CHROMA_URL=http://localhost:8000
