# Server port
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/ai_chatbot

# Secret used to sign JWT auth tokens
JWT_SECRET=your_jwt_secret_here

# Cohere API key used for chat generation and optional vector embeddings
COHERE_API_KEY=your_cohere_api_key_here

# Optional chat providers. Leave a key unset to keep that model unavailable.
# These values are read only by the Express server and are never sent to the client.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Optional provider model overrides
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.0-flash

# Optional Chroma vector database. Uploads and document search still work
# through the MongoDB fallback when Chroma is not running.
CHROMA_URL=http://localhost:8000
